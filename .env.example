# Where the agent reaches Ollama. In compose this is the ollama service; on the host use http://localhost:11434.
OLLAMA_API_BASE=http://ollama:11434
# Model pulled by the compose model-pull service.
OLLAMA_MODEL=gemma4:e2b
# Optional: override the harness model, e.g. ollama_chat/gemma4:e4b or ollama_chat/podcast-exec:r1
PODCAST_MODEL=
# Optional: 1 = ignore the LLM response cache
PODCAST_NO_CACHE=
# Optional: reference "today" for the fact-check judge (default: the real date)
PODCAST_TODAY=
